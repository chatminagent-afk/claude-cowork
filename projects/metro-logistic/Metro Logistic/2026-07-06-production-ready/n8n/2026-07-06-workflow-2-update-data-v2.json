    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ============================================================\n// WF2 - Node Code: validasi input update.\n// Field wajib: no_resi, nama_admin, status, lokasi.\n// Tidak boleh kosong / hanya spasi. Status harus salah satu enum.\n// Jika invalid => set flag valid=false + pesan error (respond 400 nanti).\n// ============================================================\n\nconst ENUM_STATUS = [\n  \"Manifest\", \"On Process\", \"Transit\",\n  \"Out for Delivery\", \"Delivered\", \"Failed/Return\"\n];\n\nconst body = ($json.body) ? $json.body : $json;\nfunction bersih(v) { return (v === undefined || v === null) ? \"\" : String(v).trim(); }\n\nconst no_resi = bersih(body.no_resi).toUpperCase();\nconst nama_admin = bersih(body.nama_admin);\nconst status = bersih(body.status);\nconst lokasi = bersih(body.lokasi);\nconst client_id = bersih(body.client_id);\n\nconst errors = [];\nif (!no_resi) errors.push(\"no_resi wajib diisi\");\nif (!nama_admin) errors.push(\"nama_admin wajib diisi\");\nif (!status) errors.push(\"status wajib diisi\");\nif (!lokasi) errors.push(\"lokasi wajib diisi\");\nif (status && !ENUM_STATUS.includes(status)) {\n  errors.push(\"status tidak valid. Pilihan: \" + ENUM_STATUS.join(\", \"));\n}\n\nif (errors.length > 0) {\n  return [{ json: { valid: false, error: errors.join(\"; \") } }];\n}\n\nreturn [{ json: {\n  valid: true, no_resi, nama_admin, status, lokasi, client_id\n} }];\n"
      },
      "id": "code-validasi",
      "name": "Code Validasi Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        400
      ]
