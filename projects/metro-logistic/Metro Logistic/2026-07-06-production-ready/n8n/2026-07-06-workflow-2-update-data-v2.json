    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ============================================================\n// WF2 - Node Code: siapkan penulisan LOG_HISTORY + SNAPSHOT TRACKING.\n// [ENHANCEMENT 2026-07-06]\n//   - Setiap update SELALU ditulis sebagai satu baris baru di sheet\n//     Log_History (kolom terpisah): Timestamp_Update, No_Resi, Status,\n//     Lokasi, Nama_Admin, Client_ID.\n//   - Sheet Tracking hanya menyimpan SNAPSHOT TERBARU per resi\n//     (satu baris per resi, kolom terpisah, tanpa JSON riwayat).\n//   - Idempotensi: bila Client_ID sudah ada di Log_History, request ini\n//     adalah retry/duplikat => tidak menulis apa pun, balas sukses.\n// Output: satu item berisi field Log_* (untuk append Log_History) +\n//   field snapshot Tracking + mode ('update'/'append') + duplikat + row_number.\n// ============================================================\n\nconst val = $items('Code Validasi Input')[0].json;\nconst no_resi = val.no_resi;\nconst nama_admin = val.nama_admin;\nconst status = val.status;\nconst lokasi = val.lokasi;\nconst client_id = val.client_id || '';\n\n// Waktu sekarang ISO 8601 dengan offset +07:00 (Asia/Jakarta).\nfunction nowJakartaISO() {\n  const d = new Date(Date.now() + 7 * 60 * 60 * 1000);\n  const pad = (n) => String(n).padStart(2, '0');\n  return `${d.getUTCFullYear()}-${pad(d.getUTCMonth()+1)}-${pad(d.getUTCDate())}` +\n         `T${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}:${pad(d.getUTCSeconds())}+07:00`;\n}\nconst waktu = nowJakartaISO();\n\n// Rows dari sheet Log_History (untuk idempotensi + hitung total riwayat).\nconst logRows = $items('Baca Sheet Log_History').map(i => i.json)\n  .filter(r => String(r.No_Resi || '').trim() !== '');\n\n// IDEMPOTENSI: Client_ID sudah pernah tercatat => duplikat.\nif (client_id) {\n  const sudahAda = logRows.some(r => String(r.Client_ID || '') === client_id);\n  if (sudahAda) {\n    const totalResi = logRows.filter(r =>\n      String(r.No_Resi || '').trim().toUpperCase() === no_resi).length;\n    return [{ json: {\n      duplikat: true,\n      mode: 'noop',\n      No_Resi: no_resi,\n      total_riwayat: totalResi\n    } }];\n  }\n}\n\n// Hitung total riwayat resi ini SETELAH update ini (existing + 1).\nconst totalSebelum = logRows.filter(r =>\n  String(r.No_Resi || '').trim().toUpperCase() === no_resi).length;\nconst total_riwayat = totalSebelum + 1;\n\n// Cari snapshot resi di sheet Tracking.\nconst trackingRows = $items('Baca Sheet Tracking').map(i => i.json);\nlet baris = null;\nfor (const row of trackingRows) {\n  if (String(row.No_Resi || '').trim().toUpperCase() === no_resi) { baris = row; break; }\n}\n\nconst out = {\n  duplikat: false,\n  // ── Field untuk append ke Log_History ──\n  Log_Timestamp_Update: waktu,\n  Log_No_Resi: no_resi,\n  Log_Status: status,\n  Log_Lokasi: lokasi,\n  Log_Nama_Admin: nama_admin,\n  Log_Client_ID: client_id,\n  // ── Field snapshot Tracking ──\n  No_Resi: no_resi,\n  Status_Terakhir: status,\n  Lokasi_Terakhir: lokasi,\n  Nama_Admin: nama_admin,\n  Timestamp_Update: waktu,\n  total_riwayat: total_riwayat\n};\n\nif (baris) {\n  out.mode = 'update';\n  out.row_number = baris.row_number;\n} else {\n  out.mode = 'append';\n}\n\nreturn [{ json: out }];\n"
      },
