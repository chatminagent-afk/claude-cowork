    {
      "parameters": {
        "jsCode": "// $input = Pekerja sheet rows (from GS - Read Pekerja Reminder)\nconst pekerjaRows   = $input.all().map(i => i.json).filter(r => r.Nama || r.nama);\nconst pekerjaanRows = $('GS - Read Pekerjaan Reminder2').all().map(i => i.json)\n  .filter(r => r.Batch_ID && r.Pekerjaan);\nconst statusRows    = $('GS - Read Status Reminder2').all().map(i => i.json)\n  .filter(r => r.Batch_ID && r.No_Item && r.Status);\n\n// Latest status per \"Batch_ID|No_Item\"\nconst latestStatus = {};\nstatusRows.forEach(r => {\n  latestStatus[r.Batch_ID + '|' + r.No_Item] = r.Status;\n});\n\n// WIB time period\nconst wibHour = (new Date().getUTCHours() + 7) % 24;\nconst period  = wibHour < 12 ? 'Pagi' : wibHour < 17 ? 'Siang' : 'Malam';\n\n// Build per-batch, per-item — skip done items\nconst batches = {};\npekerjaanRows.forEach(r => {\n  const bid    = r.Batch_ID;\n  const noItem = r.No_Item || 1;\n  const status = latestStatus[bid + '|' + noItem] || 'pending';\n  if (status === 'done') return;\n\n  if (!batches[bid]) {\n    batches[bid] = {\n      batch_id: bid,\n      project:  (String(r.Proyek  || '')).trim(),\n      pekerja:  (String(r.Pekerja || '')).trim(),\n      catatan:  (String(r.Catatan || '')).trim(),\n      items:    []\n    };\n  }\n  batches[bid].items.push({\n    pekerjaan: r.Pekerjaan,\n    vol:       r.Vol,\n    sat:       r.Sat,\n    status\n  });\n});\n\n// Group non-empty batches by pekerja\nconst byPekerja = {};\nObject.values(batches).forEach(b => {\n  if (!b.pekerja || b.items.length === 0) return;\n  if (!byPekerja[b.pekerja]) byPekerja[b.pekerja] = [];\n  byPekerja[b.pekerja].push(b);\n});\n\nif (Object.keys(byPekerja).length === 0) return [];\n\n// Build WA per pekerja\nconst result = [];\nObject.entries(byPekerja).forEach(([nama, jobs]) => {\n  const worker   = pekerjaRows.find(w => (String(w.Nama || w.nama || '')).trim() === nama);\n  const rawPhone = worker ? (worker.No_HP || worker.no_hp || '').toString().trim() : '';\n  const phone    = rawPhone.replace(/\\D/g,'').replace(/^0+/,'62');\n  if (!phone) return;\n\n  let msg = `\\u23F0 *Pengingat ${period} \\u2014 TIM Interior*\\n\\n`;\n  msg += `Halo *${nama}*! Item pekerjaan yang masih perlu diselesaikan:\\n\\n`;\n\n  jobs.forEach(job => {\n    msg += `\\ud83d\\udccb *${job.project}*`;\n    if (job.catatan) msg += ` \\u2014 ${job.catatan}`;\n    msg += `\\n`;\n    job.items.slice(0, 6).forEach((it, i) => {\n      const stIcon = it.status === 'inprogress' ? '\\ud83d\\udd28' : '\\u23f3';\n      msg += `  ${stIcon} ${it.pekerjaan} (${it.vol} ${it.sat})\\n`;\n    });\n    if (job.items.length > 6) msg += `  ... +${job.items.length - 6} item lainnya\\n`;\n    msg += `\\n`;\n  });\n  msg += `_Update via aplikasi TIM Interior_`;\n\n  result.push({ json: { phone, waMessage: msg, pekerja: nama, totalItems: jobs.reduce((s,j)=>s+j.items.length,0) } });\n});\n\nreturn result;"
      },
