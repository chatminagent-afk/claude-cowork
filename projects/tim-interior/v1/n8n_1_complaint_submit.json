            { "id": "Tanggal_Komplain", "displayName": "Tanggal_Komplain", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "Nama_Project",     "displayName": "Nama_Project",     "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
