    {
      "id": "code-parse-toggle-global",
      "name": "Parse Toggle Global Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 800],
      "parameters": {
        "jsCode": "const body   = $input.first().json.body || $input.first().json;\nconst status = String(body.status || 'ON').trim().toUpperCase() === 'OFF' ? 'OFF' : 'ON';\nreturn [{ json: { status } }];"
      }
    },

    {
      "id": "update-vira-status",
