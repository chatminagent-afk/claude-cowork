      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 320],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, wa: $('Parse Toggle User Payload').first().json.wa, bot_mode: $('Parse Toggle User Payload').first().json.mode, message: 'Bot mode updated in Google Sheets' }) }}",
        "options": {
