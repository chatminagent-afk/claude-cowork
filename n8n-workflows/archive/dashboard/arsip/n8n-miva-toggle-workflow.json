    {
      "id": "agg-config",
      "name": "Aggregate CONFIG",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1920, 0],
      "parameters": {
        "aggregate": "aggregateAllItemData",
