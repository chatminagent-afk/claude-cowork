            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        }
      }
    },

    {
      "id": "wh-toggle-global",
      "name": "Webhook — Toggle Global",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [0, 800],
      "parameters": {
        "httpMethod": "POST",
        "path": "vira-toggle-global",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "*" }
      },
      "webhookId": "vira-toggle-global"
