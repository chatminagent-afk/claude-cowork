      "typeVersion": 1.1,
      "position": [720, 520],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: $json.error || 'INVALID_WA', message: $json.message || 'Invalid or missing WA number' }) }}",
