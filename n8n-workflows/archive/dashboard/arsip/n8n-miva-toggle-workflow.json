      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [480, 800],
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "1tEJYayS0pQTVO2FI9xO363nQBkjFz5TL5u0-zsa-CwE", "mode": "id" },
        "sheetName": { "__rl": true, "value": "CONFIG", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Key": "VIRA_STATUS",
            "Value": "={{ $('Parse Toggle Global Payload').first().json.status }}"
          },
          "matchingColumns": ["Key"],
          "schema": []
        },
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "3gTKMbD8lJDLbRqR", "name": "Google Service Account thescholars" } }
    },

    {
