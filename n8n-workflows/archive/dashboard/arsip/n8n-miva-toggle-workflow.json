    {
      "id": "code-build-response",
      "name": "Build DB Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2160, 0],
      "parameters": {
        "jsCode": "// Retrieve aggregated arrays from previous nodes\nconst stats   = $('Aggregate STATS').first().json.STATS || [];\nconst mock    = $('Aggregate MOCK').first().json.MOCK_INTERVIEW_BOOKING || [];\nconst unknown = $('Aggregate UNKNOWN').first().json.UNKNOWN || [];\nconst config  = $('Aggregate CONFIG').first().json.CONFIG || [];\n\n// Determine VIRA global status from CONFIG\nconst viraEntry = config.find(c => String(c.Key || '').trim() === 'VIRA_STATUS');\nconst globalStatus = viraEntry ? String(viraEntry.Value || 'ON').trim().toUpperCase() : 'ON';\n\nreturn [{\n  json: {\n    ok: true,\n    globalStatus,\n    database: {\n      STATS: stats,\n      MOCK_INTERVIEW_BOOKING: mock,\n      UNKNOWN: unknown,\n      CONFIG: config\n    }\n  }\n}];"
      }
    },

    {
      "id": "respond-getdata",
      "name": "Respond — Data",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2400, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Access-Control-Allow-Headers", "value": "Content-Type" },
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        }
      }
    },

    {
      "id": "wh-toggle-user",
      "name": "Webhook — Toggle User",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [0, 400],
      "parameters": {
        "httpMethod": "POST",
        "path": "vira-toggle-user",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "*" }
      },
      "webhookId": "vira-toggle-user"
    },

    {
      "id": "code-parse-toggle-user",
      "name": "Parse Toggle User Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 400],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst rawWA = String(body.wa || '').replace(/\\.0$/, '').replace(/[^0-9]/g, '');\nconst mode  = String(body.mode || 'ON').trim().toUpperCase() === 'OFF' ? 'OFF' : 'ON';\n\nif (!rawWA) {\n  return [{ json: { ok: false, error: 'MISSING_WA', wa: '', mode, message: 'wa field is required' } }];\n}\n\nreturn [{ json: { ok: true, wa: rawWA, mode } }];"
      }
    },

    {
      "id": "if-wa-valid",
      "name": "WA Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 400],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },

    {
      "id": "update-bot-mode",
      "name": "Update bot_mode in STATS",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [720, 320],
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "1tEJYayS0pQTVO2FI9xO363nQBkjFz5TL5u0-zsa-CwE", "mode": "id" },
        "sheetName": { "__rl": true, "value": "STATS", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "No WA": "={{ $('Parse Toggle User Payload').first().json.wa }}",
            "bot_mode": "={{ $('Parse Toggle User Payload').first().json.mode }}"
          },
          "matchingColumns": ["No WA"],
          "schema": []
        },
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "3gTKMbD8lJDLbRqR", "name": "Google Service Account thescholars" } }
    },

    {
