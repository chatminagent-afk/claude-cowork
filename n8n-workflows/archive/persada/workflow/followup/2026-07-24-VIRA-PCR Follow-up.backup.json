    {
      "parameters": {
        "jsCode": "// Baca CONFIG (key/value) -> objek cfg + gate jam etis WIB\nconst rows = $input.all().map(i => i.json);\nconst cfg = {};\nfor (const r of rows) {\n  const k = String(r.key || r.Key || '').trim();\n  if (k) cfg[k] = (r.value !== undefined && r.value !== null) ? r.value : ((r.Value !== undefined && r.Value !== null) ? r.Value : '');\n}\nconst num = (k, d) => { const n = Number(cfg[k]); return isNaN(n) ? d : n; };\n\nlet templates = [];\ntry { templates = JSON.parse(cfg.followup_templates || '[]'); } catch (e) { templates = []; }\nif (!Array.isArray(templates)) templates = [];\n\nconst openH = num('followup_open_hour', 8);\nconst closeH = num('followup_close_hour', 21);\nconst wibHour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Jakarta', hour: '2-digit', hour12: false }).format(new Date()));\n\n// Di luar jam etis atau template kosong -> stop; trigger jam berikutnya coba lagi.\n// Kandidat yang \"ketinggalan\" otomatis terkirim di slot pertama hari berikutnya.\nif (wibHour < openH || wibHour >= closeH) return [];\nif (!templates.length) return [];\n\nreturn [{ json: {\n  config: {\n    kirimi_user_code: String(cfg.kirimi_user_code || '').trim(),\n    kirimi_secret: String(cfg.kirimi_secret || '').trim(),\n    kirimi_device_id: String(cfg.kirimi_device_id || '').trim(),\n    admin_phone: String(cfg.admin_phone || '').trim(),\n    exclude_numbers: [cfg.admin_phone, cfg.admin_phone_display, cfg.field_team_phone, cfg.media_team_phone]\n      .map(v => String(v || '').replace(/\\D/g, '')).filter(Boolean),\n    followup_max: num('followup_max', 0),\n    followup_interval_hours: num('followup_interval_hours', 72),\n    templates: templates\n  },\n  now_epoch: Math.floor(Date.now() / 1000)\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
