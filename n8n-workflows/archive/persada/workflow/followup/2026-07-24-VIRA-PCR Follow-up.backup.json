    {
      "parameters": {
        "jsCode": "// Saring baris STATS -> user yang layak di-follow-up sekarang\nconst base = $('Parse Config FU').first().json;\nconst cfg = base.config;\nconst now = base.now_epoch;\nconst intervalSec = (cfg.followup_interval_hours || 72) * 3600;\nconst out = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const noWa = String(row['No WA'] || '').trim();\n  if (!noWa) continue;\n  const digits = noWa.replace(/\\D/g, '');\n  if (cfg.exclude_numbers.includes(digits)) continue;           // nomor tim/admin\n  if (/^off$/i.test(String(row['bot_mode'] || '').trim())) continue;              // sudah dipegang manusia\n  if (/^scheduled$/i.test(String(row['survey_status'] || '').trim())) continue;   // goal tercapai\n  if (Number(row['Counter'] || 0) < 1) continue;                // belum pernah chat\n\n  const lastReply = Number(row['last_reply_ts'] || 0);\n  if (!lastReply) continue;                                     // belum pernah dibalas bot\n  if (now - lastReply < intervalSec) continue;                  // masih hangat, jangan ganggu\n\n  const lastFu = Number(row['last_follow_up_ts'] || 0);\n  if (lastFu && now - lastFu < intervalSec) continue;           // belum 3 hari sejak follow-up terakhir\n\n  const fuCount = Number(row['follow_up_count'] || 0);\n  if (cfg.followup_max > 0 && fuCount >= cfg.followup_max) continue;  // 0 = tanpa batas\n\n  out.push({ json: {\n    no_wa: noWa,\n    lid: String(row['lid'] || '').trim(),\n    nama: String(row['Nama'] || '').trim(),\n    follow_up_count: fuCount,\n    message: cfg.templates[fuCount % cfg.templates.length]      // siklus 1..N lalu ulang\n  } });\n}\nreturn out;"
      },
