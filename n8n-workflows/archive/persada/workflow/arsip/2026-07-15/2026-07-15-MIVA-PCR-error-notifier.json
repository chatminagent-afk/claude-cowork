      "id": "a2b96538-afc8-41c5-8188-a0952c6b1cba",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "// Susun notifikasi error untuk admin\nconst e = $input.first().json;\nconst wfName = e.workflow?.name || 'VIRA';\nconst execId = e.execution?.id || '-';\nconst node = e.execution?.error?.node?.name || e.execution?.lastNodeExecuted || '-';\nconst msg = (e.execution?.error?.message || 'unknown error').substring(0, 300);\nconst url = e.execution?.url || '-';\n\nconst text = `🚨 [PCR ${wfName}] EKSEKUSI GAGAL\\nNode: ${node}\\nError: ${msg}\\nExecution: ${execId}\\n${url}\\n\\n⚠️ Ada pesan user yang kemungkinan TIDAK terbalas. Cek & balas manual.`;\n\nreturn [{ json: { notif_text: text } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "faed4416-426b-44a6-b3a9-68994ca32922",
      "name": "Compose Notif"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.kirimi.id/v1/send-message",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "{{ADMIN_PHONE}}"
            },
            {
              "name": "message",
              "value": "={{ $json.notif_text }}"
            }
          ]
        },
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
