    {
      "parameters": {
        "jsCode": "\nconst now = Math.floor(Date.now() / 1000);\n\n// Input dari Read STATS\nconst statsRows = $input.all();\n\nconst toFollow = [];\n\nfor (const item of statsRows) {\n  const row = item.json;\n  const wa            = row['No WA'];\n  const lastTs        = row['timestamp'];\n  const lastFollowStr = row['last follow up'];\n  const followCount   = parseInt(row['follow_up_count'] || '0', 10);\n  const botMode       = String(row['bot_mode'] || '').trim().toUpperCase();\n  const gformSentTs   = parseInt(row['gform_sent_ts'] || '0', 10);\n  const gformFilled   = String(row['gform_filled'] || '').trim().toUpperCase();\n\n  if (!wa) continue;\n  if (followCount >= 3) continue;              // max 3x follow up\n  if (botMode === 'OFF' || botMode === 'N') continue;             // Sam sedang handle manual\n\n  // PRIORITAS 1: Follow up GForm (24 jam setelah link dikirim, belum diisi)\n  if (gformSentTs > 0 && gformFilled !== 'Y') {\n    const hoursSinceGForm = (now - gformSentTs) / 3600;\n    if (hoursSinceGForm >= 24 && hoursSinceGForm < 168) { // 24h - 7 hari\n      // Cek jeda dari follow up terakhir\n      if (lastFollowStr && lastFollowStr.toString().trim() !== '') {\n        const lastFollowTs = Number(lastFollowStr);\n        if (now - lastFollowTs <= 86400) continue; // tunggu 24 jam antar FU\n      }\n      toFollow.push({\n        json: {\n          noWA: wa,\n          nama: row['Nama'] || 'Kak',\n          followType: 'GFORM_REMINDER',\n          followCount: followCount,\n          followUpCount: followCount + 1,\n          gformSentTs,\n        }\n      });\n      continue;\n    }\n  }\n\n  // PRIORITAS 2: General follow up (belum pernah dapat GForm, tidak aktif > 24 jam)\n  if (!lastTs) continue;\n  if (now - lastTs <= 86400) continue;\n  if (gformSentTs > 0) continue; // sudah dapat GForm, ditangani di atas\n\n  if (lastFollowStr && lastFollowStr.toString().trim() !== '') {\n    const lastFollowTs = Number(lastFollowStr);\n    if (now - lastFollowTs <= 172800) continue; // 48 jam antar general FU\n  }\n\n  toFollow.push({\n    json: {\n      noWA: wa,\n      nama: row['Nama'] || 'Kak',\n      followType: 'GENERAL',\n      followCount: followCount,\n      followUpCount: followCount + 1,\n    }\n  });\n}\n\nconsole.log(`Follow up queue: ${toFollow.length} users`);\nreturn toFollow;\n"
      },
