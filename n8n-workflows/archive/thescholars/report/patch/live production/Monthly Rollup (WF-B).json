    {
      "parameters": {
        "jsCode": "// Rekap TOPIC_LOG bulan lalu -> satu baris MONTHLY_SUMMARY.\n// Peringkat dihitung per USER UNIK, bukan per pesan: satu orang yang bertanya\n// enam kali tidak boleh menggelembungkan persentase.\n\nconst TOP_N = 10;\nconst NOISE = 'lainnya';  // sapaan/ucapan terima kasih/fragmen — dihitung, tapi tidak diperingkat\n\nfunction bulanWIB(d) {\n  const p = new Intl.DateTimeFormat('en-GB', {\n    timeZone: 'Asia/Jakarta', year: 'numeric', month: '2-digit'\n  }).formatToParts(d);\n  return p.find(x => x.type === 'year').value + '-' + p.find(x => x.type === 'month').value;\n}\n\n// Bulan sasaran = bulan sebelum bulan berjalan (WIB).\n// Dihitung dengan mundur ke tanggal 15 bulan lalu supaya aman dari beda panjang bulan & DST.\nconst now = new Date();\nconst nowWIB = bulanWIB(now);\nconst [y, m] = nowWIB.split('-').map(Number);\nconst prev = new Date(Date.UTC(m === 1 ? y - 1 : y, m === 1 ? 11 : m - 2, 15, 5, 0, 0));\nconst target = bulanWIB(prev);\n\n// --- kumpulkan baris bulan sasaran ---\nconst users = new Set();\nconst perTopicUsers = {};   // topic -> Set(user)\nconst perTopicMsgs = {};    // topic -> jumlah pesan\nlet totalPesan = 0, pesanNoise = 0;\nconst topikBaru = {};       // label NEW: -> jumlah user\n\nfor (const item of $('Read TOPIC_LOG').all()) {\n  const r = item.json || {};\n  if (String(r.bulan || '').trim() !== target) continue;\n\n  const user = String(r.user_key || '').trim();\n  const topic = String(r.topic || '').trim();\n  const n = Number(r.jumlah_pesan) || 0;\n  if (!user || !topic) continue;\n\n  users.add(user);\n  totalPesan += n;\n\n  if (topic === NOISE) { pesanNoise += n; continue; }\n\n  if (!perTopicUsers[topic]) { perTopicUsers[topic] = new Set(); perTopicMsgs[topic] = 0; }\n  perTopicUsers[topic].add(user);\n  perTopicMsgs[topic] += n;\n\n  if (topic.indexOf('NEW:') === 0) {\n    topikBaru[topic] = (topikBaru[topic] || 0) + 1;\n  }\n}\n\nconst totalUser = users.size;\n\nconst ranked = Object.keys(perTopicUsers).map(t => ({\n  topic: t,\n  users: perTopicUsers[t].size,\n  messages: perTopicMsgs[t],\n  pct: totalUser ? Math.round((perTopicUsers[t].size / totalUser) * 1000) / 10 : 0\n})).sort((a, b) => (b.users - a.users) || (b.messages - a.messages) || a.topic.localeCompare(b.topic));\n\nconst top = ranked.slice(0, TOP_N);\n\n// Persentase sengaja BOLEH berjumlah >100%: satu user bisa membawa beberapa topik.\nconst note = totalUser === 0\n  ? 'Belum ada data untuk bulan ini.'\n  : 'Berdasarkan percakapan yang ditangani VIRA. Chat yang sudah diambil alih Sam tidak ikut terhitung. '\n    + 'Satu user bisa menanyakan lebih dari satu topik, jadi jumlah persentase bisa melebihi 100%.';\n\nreturn [{ json: {\n  bulan: target,\n  total_user_unik: totalUser,\n  total_pesan: totalPesan,\n  top_json: JSON.stringify(top),\n  topik_baru_json: JSON.stringify(Object.keys(topikBaru).sort()),\n  pesan_lainnya: pesanNoise,\n  topik_terpakai: ranked.length,\n  coverage_note: note,\n  generated_at: new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' })\n} }];\n"
      },
