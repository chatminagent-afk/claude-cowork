        "jsCode": "const configRows  = $input.all();\nconst bookingRow  = $('Read Booking by ID (Confirm)').first().json;\nconst { id, action } = $('Parse Confirm Request').first().json;\n\n// Build config map\nconst cfg = {};\nconfigRows.forEach(r => {\n  const k = String(r.json['Key']   || '').trim();\n  const v = String(r.json['Value'] || '').trim();\n  if (k) cfg[k] = v;\n});\n\nconst status = String(bookingRow['Status'] || '').trim();\n\nreturn [{ json: {\n  id,\n  action,\n  alreadyProcessed : status !== 'Pending',\n  status,\n  namaAnak         : String(bookingRow['Nama Anak']   || '').trim(),\n  noWaAnak         : String(bookingRow['No WA Anak']  || '').trim(),\n  tanggal          : String(bookingRow['Tanggal']     || '').trim(),\n  jamMulai         : String(bookingRow['Jam Mulai']   || '').trim(),\n  jamSelesai       : String(bookingRow['Jam Selesai'] || '').trim(),\n  slotId           : String(bookingRow['Slot ID']     || '').trim(),\n  // Config (fallback ke dummy jika sheet belum diisi)\n  nominalBiaya     : cfg['NOMINAL_BIAYA']   || '1.000.000',\n  namaBank         : cfg['NAMA_BANK']       || 'BCA',\n  nomorRekening    : cfg['NOMOR_REKENING']  || '1820111111',\n  atasNama         : cfg['ATAS_NAMA']       || 'Samuel Oscar',\n  deadlineHari     : cfg['DEADLINE_HARI']   || '1',\n}}];"
      },
