      "parameters": {
        "jsCode": "const slotRows = $input.all();\nconst payload  = $('Validate Payload').first().json;\n\nif (slotRows.length === 0) {\n  return [{ json: { slotTaken: true, reason: 'SLOT_NOT_FOUND', ...payload } }];\n}\n\nconst slot   = slotRows[0].json;\nconst Booked = String(slot['Booked'] || '').trim().toUpperCase();\n\nif (Booked === 'Y') {\n  return [{ json: { slotTaken: true, reason: 'SLOT_TAKEN', ...payload } }];\n}\n\nreturn [{ json: { slotTaken: false, rowNumber: slot.row_number, ...payload } }];"
