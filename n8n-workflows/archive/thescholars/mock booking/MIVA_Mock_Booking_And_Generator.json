    {
      "parameters": {
        "jsCode": "// Runs on the 1st of each month.\n// Generates slots for the NEXT month.\n// Days: Monday(1), Tuesday(2), Thursday(4), Friday(5) — skip Wednesday & weekend.\n// Time: 19:30 – 21:30 WIB\n\nconst WEEKDAY_ID = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];\nconst MONTH_ID   = [\n  'Januari','Februari','Maret','April','Mei','Juni',\n  'Juli','Agustus','September','Oktober','November','Desember'\n];\n\nconst now        = new Date();\nconst nextFirst  = new Date(now.getFullYear(), now.getMonth() + 1, 1);\nconst year       = nextFirst.getFullYear();\nconst month      = nextFirst.getMonth(); // 0-indexed\n\nconst slots = [];\nconst d     = new Date(year, month, 1);\n\nwhile (d.getMonth() === month) {\n  const dow = d.getDay();\n  // Include Mon(1), Tue(2), Thu(4), Fri(5)\n  if ([1, 2, 4, 5].includes(dow)) {\n    const dd    = String(d.getDate()).padStart(2, '0');\n    const mm    = String(month + 1).padStart(2, '0');\n    const yyyy  = String(year);\n    const id    = `SLOT-${yyyy}${mm}${dd}`;\n    const label = `${WEEKDAY_ID[dow]}, ${d.getDate()} ${MONTH_ID[month]} ${year}`;\n    slots.push({\n      ID          : id,\n      Tanggal     : label,\n      JamMulai    : '19:30',\n      JamSelesai  : '21:30',\n      Booked      : '',\n      NamaPemesan : '',\n      NoWaPemesan : '',\n    });\n  }\n  d.setDate(d.getDate() + 1);\n}\n\nif (slots.length === 0) throw new Error('No slots generated — check month logic.');\n\n// Store summary for notify node\n$vars.slotCount  = slots.length;\n$vars.monthLabel = `${MONTH_ID[month]} ${year}`;\n\nreturn slots.map(s => ({ json: s }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        1056
      ],
      "id": "8304a15e-c68f-4a0a-8ab8-90059a5969c7",
