      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst slots = rows\n  .filter(r => String(r.json['Booked'] || '').trim().toUpperCase() !== 'Y')\n  .map(r => ({\n    id        : String(r.json['ID']         || '').trim(),\n    tanggal   : String(r.json['Tanggal']    || '').trim(),\n    jamMulai  : String(r.json['JamMulai']   || '').trim(),\n    jamSelesai: String(r.json['JamSelesai'] || '').trim(),\n    booked    : false,\n  }))\n  .filter(s => s.id && s.tanggal && s.jamMulai && s.jamSelesai);\n\nreturn [{ json: { slots } }];"
      },
