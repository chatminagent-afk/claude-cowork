    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst required = [\n  'idBooking', 'tanggal', 'noWaAnak', 'namaAnak', 'namaOrangTua',\n  'asalKota', 'sekolah', 'kelas', 'kurikulumSekolah', 'targetUniJurusan',\n  'jamMulai', 'jamSelesai', 'slotId'\n];\nconst missing = required.filter(k => !body[k] || String(body[k]).trim() === '');\nif (missing.length > 0) throw new Error('Missing fields: ' + missing.join(', '));\n\nconst wa = String(body.noWaAnak).trim();\nif (!/^(08\\d{8,12}|628\\d{8,12})$/.test(wa)) throw new Error('Format noWaAnak tidak valid: ' + wa);\n\nreturn [{ json: {\n  idBooking        : String(body.idBooking).trim(),\n  tanggal          : String(body.tanggal).trim(),\n  noWaAnak         : wa,\n  namaAnak         : String(body.namaAnak).trim(),\n  namaOrangTua     : String(body.namaOrangTua).trim(),\n  asalKota         : String(body.asalKota).trim(),\n  sekolah          : String(body.sekolah).trim(),\n  kelas            : String(body.kelas).trim(),\n  kurikulumSekolah : String(body.kurikulumSekolah).trim(),\n  targetUniJurusan : String(body.targetUniJurusan).trim(),\n  bimbingan        : 'University Mock Interview',\n  jamMulai         : String(body.jamMulai).trim(),\n  jamSelesai       : String(body.jamSelesai).trim(),\n  slotId           : String(body.slotId).trim(),\n  status           : 'Pending',\n  timestamp        : body.timestamp || Math.floor(Date.now() / 1000),\n}}];"
      },
